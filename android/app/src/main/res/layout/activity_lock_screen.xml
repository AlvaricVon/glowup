<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0a0a"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="600dp"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvPrayerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Sholat"
            android:textColor="#10b981"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:textColor="#e5e5e5"
            android:textSize="16sp" />

        <!-- Langkah 1: jalan 30 meter -->
        <LinearLayout
            android:id="@+id/walkStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Langkah 1 dari 3"
                android:textColor="#a3a3a3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jalan dulu biar kebukti bangun"
                android:textColor="#fafafa"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWalkCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0 / 30 meter"
                android:textColor="#10b981"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/walkProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="16dp"
                android:max="30"
                android:progress="0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Jalan pelan-pelan aja, HP-nya usahain goyang dikit. Nanti ke-track sendiri."
                android:textColor="#a3a3a3"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnWalkSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="#404040"
                android:text="Sensor gak kebaca? tap di sini"
                android:textAllCaps="false"
                android:textColor="#d4d4d4"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Langkah 2: foto keran -->
        <LinearLayout
            android:id="@+id/photoStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚰"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Langkah 2 dari 3"
                android:textColor="#a3a3a3"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Foto keran kamar mandi"
                android:textColor="#fafafa"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Pergi ke kamar mandi, wudhu, terus foto kerannya. Bukti lo beneran turun dari kasur."
                android:textColor="#a3a3a3"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="#10b981"
                android:padding="18dp"
                android:text="Ambil Foto Keran"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPhotoStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#f3b93b"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnPhotoSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="#404040"
                android:text="Kamera gak jalan? tap buat lanjut"
                android:textAllCaps="false"
                android:textColor="#d4d4d4"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Langkah 3: konfirmasi -->
        <LinearLayout
            android:id="@+id/finalStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgProof"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="8dp"
                android:background="#1a1a1a"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvProofLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="✓ Bukti keran ke-record"
                android:textColor="#10b981"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUnlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#10b981"
                android:padding="20dp"
                android:text="gw udah sholat, wallahi"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinalHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Konfirmasi baru buka kunci"
                android:textColor="#737373"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
